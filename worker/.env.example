# Postgres connection string (Supabase: Project settings > Database > Connection string, session mode)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0
# Optional. Without it, uncertain postings wait in the admin review queue instead.
ANTHROPIC_API_KEY=
OPENPATH_AI_MODEL=claude-opus-5-5
OPENPATH_AI_MAX_CALLS_PER_SCAN=10
# Display Advert API key for GOV.UK apprenticeships. Create an account at:
# https://developer.apprenticeships.education.gov.uk/third-party-accounts/register
# Without it the apprenticeship source stays paused.
FIND_APPRENTICESHIP_API_KEY=
# Identify the bot honestly, with a real contact URL, before scanning at scale.
OPENPATH_USER_AGENT=OpenPathBot/0.1 (+https://your-domain.example/bot)
